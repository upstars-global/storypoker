#!/usr/bin/env python3
"""Stateful, offline GitHub API fixture for defer publishing."""
import json, os, pathlib, sys
root=pathlib.Path(os.environ['FIXTURE_DIR'])
a=sys.argv[1:]
if len(a)<2 or a[0]!='api': sys.exit(2)
ep=a[1]; method=a[a.index('--method')+1] if '--method' in a else ('POST' if '-f' in a else 'GET')
with (root/'trace.jsonl').open('a') as out: out.write(json.dumps({'endpoint':ep,'method':method,'stage':os.environ.get('STAGE'),'token':os.environ.get('GH_TOKEN')})+'\n')
state=json.loads((root/'state.json').read_text())
payload=json.load(sys.stdin) if '--input' in a else None
role=os.environ.get('GH_TOKEN')
if role=='fixture-resolver':
    if method!='GET' and not (ep=='graphql' and method=='POST'): sys.exit(7)
    if payload and payload.get('query','').startswith('mutation') and 'resolveReviewThread' not in payload['query']: sys.exit(7)
if payload and 'resolveReviewThread' in payload.get('query','') and role!='fixture-resolver': sys.exit(7)

review_id=int(os.environ.get('REVIEW_ID','202'))
review={'id':review_id,'user':{'login':'so-upstars'},'commit_id':'a'*40,'body':state.get('body','initial')}
result=None
if ep=='repos/owner/repo/commits/'+('a'*40)+'/status?per_page=100':
    print(os.environ.get('STATUS_OWNER',os.environ['RUN_URL'])); sys.exit(0)
elif ep=='repos/owner/repo/statuses/'+('a'*40):
    state['status']=dict(x.split('=',1) for i,x in enumerate(a) if i and a[i-1]=='-f')
    result={}
elif ep=='user': result={'login':'so-upstars'}
elif ep=='repos/owner/repo/pulls/42': result={'number':42,'head':{'sha':state.get('head','a'*40)}}
elif ep.startswith('repos/owner/repo/pulls/42/reviews?'):
    result=[state['origin']]+state.get('history',[])+[review]
elif ep==f'repos/owner/repo/pulls/42/reviews/{review_id}':
    if method=='GET':
        if '--jq' in a:
            print('true' if os.environ.get('MARKER','') in review['body'] and os.environ.get('SIGNATURE','') in review['body'] else 'false'); sys.exit(0)
        result={**review,'body':'unreadable'} if state.get('completion_put') and os.environ.get('FAIL_FINAL_READBACK') else review
    elif method=='PUT':
        state['put_count']=state.get('put_count',0)+1
        if str(state['put_count'])==os.environ.get('FAIL_PUT_NUMBER'):
            (root/'state.json').write_text(json.dumps(state))
            sys.exit(1)
        state['body']=payload['body']; result=review
        if os.environ.get('STAGE')=='complete': state['completion_put']=True
elif ep=='repos/owner/repo/pulls/42/reviews/101': result=state['origin']
elif ep=='repos/owner/repo/pulls/comments/1001':
    c=state['thread']['comments'][0]
    result={'id':c['databaseId'],'user':{'login':c['author']['login']},'pull_request_review_id':c['pullRequestReview']['databaseId'],'path':state['thread']['path'],'pull_request_url':'https://api.github.com/repos/owner/repo/pulls/'+('99' if state.get('wrong_pr_link') else '42'),'original_commit_id':state['origin']['commit_id']}
elif ep=='repos/owner/repo/pulls/comments/1002':
    comment=next((c for c in state['thread']['comments'] if c['databaseId']==1002),None)
    if comment is None: sys.exit(1)
    result={'id':1002,'user':{'login':comment['author']['login']},'in_reply_to_id':1001,
            'pull_request_url':'https://api.github.com/repos/owner/repo/pulls/42',
            'body':comment['body'],'updated_at':comment['updatedAt']}
elif ep=='repos/owner/repo/pulls/comments/1003':
    if os.environ.get('FAIL_REPLY_READ') or state.get('missing_reply') or not any(c['databaseId']==1003 for c in state['thread']['comments']): sys.exit(1)
    result={'id':1003,'user':{'login':'so-upstars'},'in_reply_to_id':999 if state.get('wrong_reply_root') else 1001,'pull_request_url':'https://api.github.com/repos/owner/repo/pulls/42'}
elif ep=='repos/owner/repo/collaborators/alice/permission': result={'permission':'read' if os.environ.get('FAIL_PERMISSION') else 'write'}
elif ep.startswith('repos/owner/repo/issues?'): result=([state['issue']] if state.get('issue') else [])+state.get('extra_issues',[])
elif ep=='repos/owner/repo/issues' and method=='POST':
    result={'number':57,'state':'open','html_url':'https://github.com/owner/repo/issues/57','body':payload['body'],'user':{'login':'so-upstars'}}
    state['issue']=result
elif ep=='repos/owner/repo/issues/57':
    result=state['issue']
    if os.environ.get('STAGE')=='complete' and os.environ.get('EDIT_PROPOSAL_ON_COMPLETE_READ'):
        comment=state['thread']['comments'][1]
        comment['body']=comment['body'].replace('Can wait','Changed while completing')
        comment['updatedAt']='2026-10-30T00:01:00Z'
    if os.environ.get('STAGE')=='resolve' and os.environ.get('CHANGE_HEAD_DURING_ISSUE'): state['head']='c'*40
    if os.environ.get('STAGE')=='resolve' and os.environ.get('CLOSE_ISSUE_AFTER_PREPARE'): result={**result,'state':'closed'}
elif ep=='repos/owner/repo/pulls/42/comments/1001/replies' and method=='POST':
    if os.environ.get('FAIL_REPLY'): sys.exit(1)
    result={'id':1003}
    state['thread']['comments'].append({'databaseId':1003,'author':{'login':'so-upstars'},'authorAssociation':'MEMBER','body':payload['body'],'createdAt':'2026-10-30T00:00:00Z','updatedAt':'2026-10-30T00:00:00Z','pullRequestReview':None})
elif ep=='graphql':
    q=payload['query']
    if q.startswith('mutation'):
        with (root/'trace.jsonl').open('a') as out: out.write(json.dumps({'endpoint':'graphql','method':'POST','mutation':True,'id':payload.get('variables',{}).get('id'),'token':role,'stage':os.environ.get('STAGE')})+'\n')
        if payload.get('variables',{}).get('id')!=state['thread']['id'] or os.environ.get('FAIL_RESOLVE'): sys.exit(1)
        state['thread']['isResolved']=True
        state['thread']['resolvedBy']={'login':'github-actions[bot]'}
        result={'data':{'resolveReviewThread':{'thread':{'id':state['thread']['id'],'isResolved':True}}}}
    elif 'reviewThreads' in q:
        thread=dict(state['thread']); thread['isResolved']=False if os.environ.get('FAIL_RESOLVE_READBACK') and os.environ.get('STAGE')=='complete' else thread['isResolved']; thread['comments']={'nodes':thread['comments'],'pageInfo':{'hasNextPage':False,'endCursor':None}}
        more=bool(state.get('paginated') and os.environ.get('STAGE')=='resolve' and payload.get('variables',{}).get('cursor') is None)
        result={'data':{'repository':{'pullRequest':{'reviewThreads':{'nodes':[] if more else ([thread,thread] if state.get('ambiguous') else [thread]),'pageInfo':{'hasNextPage':more,'endCursor':'threads-2' if more else None}}}}}}
if result is None: sys.exit(2)
(root/'state.json').write_text(json.dumps(state))
print(json.dumps(result))
