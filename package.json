{
  "name": "storypoker",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "sh scripts/clean.sh",
    "setup": "sh scripts/setup.sh",
    "skills": "sh scripts/skills.sh",
    "preinstall": "npm run setup",
    "postinstall": "npm run skills",
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:pages": "playwright test --project page-load",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "deploy:stage": "npx -y netlify-cli@latest deploy --alias stage",
    "deploy:prod": "npx -y netlify-cli@latest deploy --prod"
  },
  "devDependencies": {
    "@iconify-json/ic": "^1.2.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@iconify/vue": "^5.0.1",
    "@supabase/supabase-js": "^2.110.6",
    "pinia": "^4.0.2",
    "v-wave": "^3.1.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.0"
  }
}
