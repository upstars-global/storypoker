{
  "name": "storypoker",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "sh scripts/clean.sh",
    "setup": "sh scripts/setup.sh",
    "skills": "sh scripts/skills.sh",
    "preinstall": "pnpm run setup",
    "postinstall": "[ -n \"$CI\" ] || pnpm run skills",
    "predev": "pnpm run skills || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/icon-rendering/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "icons:harness:build": "vite build --config tests/icon-rendering/vite.config.ts",
    "icons:harness:preview": "vite preview --config tests/icon-rendering/vite.config.ts --port 4181 --strictPort",
    "test:icons:harness": "playwright test --config tests/icon-rendering/playwright.config.ts",
    "icons:audit-build": "node scripts/audit-icon-build.ts dist",
    "icons:generate": "node scripts/generate-icons.ts",
    "icons:check": "node scripts/generate-icons.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:pages": "playwright test --project page-load",
    "test:e2e:icons": "playwright test --project icon-delivery",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "pnpm run icons:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build",
    "deploy:stage": "npx -y netlify-cli@latest deploy --alias stage",
    "deploy:prod": "npx -y netlify-cli@latest deploy --prod --context production"
  },
  "devDependencies": {
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "echarts": "^6.1.0",
    "i18next": "^26.5.10",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router": "^8.5.0",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
