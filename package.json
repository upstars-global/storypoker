{
  "name": "storypoker",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "sh scripts/clean.sh",
    "setup": "sh scripts/setup.sh",
    "skills": "sh scripts/skills.sh",
    "preinstall": "npm run setup",
    "postinstall": "npm run skills",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tests/icon-rendering/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "icons:harness:build": "vite build --config tests/icon-rendering/vite.config.ts",
    "icons:harness:preview": "vite preview --config tests/icon-rendering/vite.config.ts --port 4181 --strictPort",
    "test:icons:harness": "playwright test --config tests/icon-rendering/playwright.config.ts",
    "icons:audit-build": "node scripts/audit-icon-build.ts dist",
    "icons:generate": "node scripts/generate-icons.ts",
    "icons:check": "node scripts/generate-icons.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:pages": "playwright test --project page-load",
    "test:e2e:icons": "playwright test --project icon-delivery",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "npm run icons:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "deploy:stage": "npx -y netlify-cli@latest deploy --alias stage",
    "deploy:prod": "npx -y netlify-cli@latest deploy --prod --context production"
  },
  "devDependencies": {
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@supabase/supabase-js": "^2.116.0",
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "v-wave": "^3.1.1",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.0"
  }
}
